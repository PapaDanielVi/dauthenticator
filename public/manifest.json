{
  "manifest_version": 3,
  "name": "DAuthenticator",
  "short_name": "DAuth",
  "version": "1.0.1",
  "description": "Local, privacy-first TOTP/HOTP authenticator with an encrypted vault, autofill and imports from Google Authenticator, Aegis, 2FAS and Bitwarden.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "DAuthenticator",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting", "alarms", "idle"],
  "commands": {
    "fill-otp": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Fill the matching 2FA code into the current page"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
